local P=game:GetService("Players").LocalPlayer
local F=workspace:WaitForChild("AutumnApples")
local on=false
local seen={}

local G=Instance.new("ScreenGui",game:GetService("CoreGui"))
local B=Instance.new("TextButton",G)
B.Size=UDim2.fromOffset(150,40)
B.Position=UDim2.new(0,20,.3,0)
B.Text="APPLE FARM: OFF"

B.MouseButton1Click:Connect(function()
 on=not on
 B.Text=on and "APPLE FARM: ON" or "APPLE FARM: OFF"
end)

local function part(v)
 return v:IsA("BasePart") and v or v:FindFirstChildWhichIsA("BasePart",true)
end

task.spawn(function()
 while task.wait(.15) do
  if on then
   local c=P.Character
   local r=c and c:FindFirstChild("HumanoidRootPart")
   if r then
    for _,v in ipairs(F:GetChildren()) do
     if v.Name:lower():find("apple") and not seen[v] then
      local p=part(v)
      if p then
       seen[v]=true
       r.CFrame=p.CFrame+Vector3.new(0,3,0)
       pcall(function()
        firetouchinterest(r,p,0)
        task.wait(.1)
        firetouchinterest(r,p,1)
       end)
       task.wait(.25)
      end
     end
    end
   end
  end
 end
end)

F.ChildAdded:Connect(function(v)
 seen[v]=nil
end)
